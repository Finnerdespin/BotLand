# Copy to .env and fill in your own Supabase / Postgres values.
# Never commit .env — secrets stay server-side only.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional
# BOTLAND_PASSWORD=botland
# BOTLAND_DB=/path/to/botland.db   # only used when DATABASE_URL is unset
